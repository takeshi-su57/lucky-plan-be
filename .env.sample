# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=
ENV=
SERVICE=API_SERVICE
REDIS_PORT=6379
REDIS_HOST=localhost
SIMULATION_EVALUATOR_GATEWAY_URL=https://api.example.com
# Give each worker a recognizable label (for example, evaluator-eu-1).
SIMULATION_EVALUATOR_WORKER_NAME=
# Event-log cache backend: file (default) or sqlite (experimental).
SIMULATION_EVALUATOR_EVENT_LOG_CACHE_DRIVER=file
# It needs only this outbound gateway URL and no database/Redis credentials.
BOT_HOOK_ADDRESS=
API_URL=
BACKTEST_INTERNAL_SECRET=
OPTUNA_POSTGRES_URL=
DRPC_TOKENS=
DRPC_PAID_TOKENS=
ALCHEMY_TOKENS=
ALCHEMY_PAID_TOENS=
