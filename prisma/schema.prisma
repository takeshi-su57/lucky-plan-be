generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Metadata {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StrategyMetadata {
  key         String     @id @db.VarChar(255)
  title       String     @db.VarChar(255)
  description String
  strategies  Strategy[]
}

model Strategy {
  id                 Int              @id @default(autoincrement())
  strategyKey        String
  params             String
  maxLeverage        Int              @default(200000)
  minLeverage        Int              @default(1100)
  ratio              Float            @default(1)
  maxCollateral      Int
  minCollateral      Int
  lifeTime           Int
  collateralBaseline Int
  bots               Bot[]
  strategyMetadata   StrategyMetadata @relation(fields: [strategyKey], references: [key])
}

model Contract {
  id                         Int            @id @default(autoincrement())
  chainId                    Int
  address                    String
  description                String
  lastBlockNumber            Int
  status                     ContractStatus @default(Live)
  lastLeaderboardBlockNumber Int            @default(0)
  backendUrl                 String?
  isTestnet                  Boolean        @default(false)
  fromBlock                  Int            @default(0)
  platform                   Platform       @default(GNS)
  toBlock                    Int?
  version                    Version        @default(V9)
  followerBots               Bot[]          @relation("followerBots")
  leaderBots                 Bot[]          @relation("leaderBots")
  sltprequests               SLTPRequest[]

  @@unique([chainId, address, version, platform])
}

model JupPerpEventLog {
  id        Int      @id @default(autoincrement())
  jsonLog   String
  slot      Int
  signature String
  date      DateTime

  @@index([signature])
}

model EventLog {
  id         Int      @id @default(autoincrement())
  contractId Int
  jsonLog    String
  block      Int
  logIndex   Int
  date       DateTime

  @@unique([contractId, block, logIndex])
}

model PerpTradingEventLog {
  id         Int      @id @default(autoincrement())
  contractId Int
  jsonLog    String
  usdPnl     Float
  block      Int
  logIndex   Int
  date       DateTime
  address    String
  platform   Platform

  @@unique([address, contractId, block, logIndex])
  @@index([platform, address, date, block, id])
  @@index([platform, date, block, id])
}

model TradingSignalLog {
  id          Int      @id @default(autoincrement())
  platform    Platform
  address     String
  eventLogIds Int[]

  @@unique([platform, address])
}

model PnlSnapshotV2 {
  id        Int             @id @default(autoincrement())
  platform  Platform
  address   String
  dateStr   String
  kind      PnlSnapshotKind
  accUSDPnl Float

  @@unique([address, platform, dateStr, kind])
  @@index([dateStr, platform, kind, accUSDPnl(sort: Desc), id(sort: Asc)])
  @@index([platform, kind, accUSDPnl(sort: Desc), id(sort: Asc)])
  @@index([dateStr, platform, id])
  @@index([dateStr, platform])
}

model PnlSnapshotV2InitializedFlag {
  id       Int      @id @default(autoincrement())
  dateStr  String
  isInit   Boolean  @default(false)
  platform Platform

  @@unique([platform, dateStr])
}

model TradeHistory {
  id                 Int             @id @default(autoincrement())
  address            String
  contractId         Int
  pnl                String
  action             TradeActionType
  block              Int
  collateralDelta    String?
  collateralIndex    Int
  collateralPriceUsd String
  date               DateTime
  leverage           Int
  long               Int
  marketPrice        String?
  pair               String
  price              String
  size               String
  tradeId            String?
  tradeIndex         Int
  leverageDelta      Int?
  isCounterTrade     Boolean?        @default(false)
  meta               String?

  @@index([address, contractId, block])
}

model PnlSnapshot {
  id         Int             @id @default(autoincrement())
  address    String
  kind       PnlSnapshotKind
  accUSDPnl  Float
  dateStr    String
  contractId Int

  @@unique([address, contractId, dateStr, kind])
  @@index([accUSDPnl(sort: Desc)])
}

model TestingReport {
  id                 Int     @id @default(autoincrement())
  minR2              Float
  investedUSD        Float
  totalUSDPnl        Float
  totalTasks         Int
  totalPositions     Int
  totalTraders       Int
  totalUniqueTraders Int
  calculatedR2       Float
  calculatedSlope    Float
  maxLoss            Float
  avgLoss            Float
  maxProfit          Float
  avgProfit          Float
  peakAccProfit      Float
  bottomAccProfit    Float
  usdPnls            Float[]
  lossCount          Int
  profitCount        Int
  allTimeWeight      Int
  m                  Int
  maxAvgSize         Int
  maxCount           Int
  minAvgSize         Int
  minCount           Int
  minScore           Float
  monthWeight        Int
  n                  Int
  threeMonthWeight   Int
  weekWeight         Int
  window             Int
}

model PnlSnapshotInitializedFlag {
  id      Int     @id @default(autoincrement())
  dateStr String  @unique
  isInit  Boolean @default(false)
}

model Log {
  id        Int         @id @default(autoincrement())
  severity  LogSeverity
  timestamp DateTime    @default(now())
  summary   String
  details   String?
  checked   Boolean     @default(false)

  @@index([severity, timestamp(sort: Desc)])
}

model User {
  address            String         @unique
  mnemonic           String
  permission         UserPermission
  allowAuto          Boolean        @default(false)
  budget             Float          @default(0)
  ratio              Float          @default(1)
  followerContractId Int            @default(0)
}

model TagCategory {
  id          Int    @id @default(autoincrement())
  category    String
  description String
  userId      String
  Tag         Tag[]

  @@unique([userId, category])
}

model Tag {
  tag         String
  color       String
  description String
  categoryId  Int?
  id          Int             @id @default(autoincrement())
  userId      String
  category    TagCategory?    @relation(fields: [categoryId], references: [id])
  wallets     WalletAccount[] @relation("TagToWalletAccount")

  @@unique([userId, tag])
}

model WalletAccount {
  address String
  id      Int    @id @default(autoincrement())
  userId  String
  tags    Tag[]  @relation("TagToWalletAccount")

  @@unique([userId, address])
}

model Follower {
  address      String @id @db.VarChar(255)
  publicKey    String @unique
  accountIndex Int
  userId       String @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots         Bot[]

  @@unique([userId, accountIndex])
}

model Plan {
  id             Int        @id @default(autoincrement())
  title          String
  description    String
  startedAt      DateTime?
  endedAt        DateTime?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         PlanStatus
  userId         String     @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots           Bot[]
}

model Bot {
  id                       Int       @id @default(autoincrement())
  leaderAddress            String    @db.VarChar(255)
  followerAddress          String    @db.VarChar(255)
  strategyId               Int
  status                   BotStatus @default(Created)
  leaderContractId         Int
  followerContractId       Int
  followerEndedBlock       Int?
  followerStartedBlock     Int?
  leaderEndedBlock         Int?
  leaderStartedBlock       Int?
  endedAt                  DateTime?
  startedAt                DateTime?
  leaderCollateralBaseline Int
  planId                   Int       @default(0)
  follower                 Follower  @relation(fields: [followerAddress], references: [address])
  followerContract         Contract  @relation("followerBots", fields: [followerContractId], references: [id])
  leaderContract           Contract  @relation("leaderBots", fields: [leaderContractId], references: [id])
  plan                     Plan      @relation(fields: [planId], references: [id])
  strategy                 Strategy  @relation(fields: [strategyId], references: [id])
  missions                 Mission[]
}

model Mission {
  id                         Int           @id @default(autoincrement())
  botId                      Int
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  status                     MissionStatus
  achievePositionKey         String?
  targetPositionKey          String
  achievePositionBlockNumber Int?
  achievePositionLogIndex    Int?
  targetPositionBlockNumber  Int
  targetPositionLogIndex     Int
  mode                       MissionMode   @default(Default)
  bot                        Bot           @relation(fields: [botId], references: [id])
  tasks                      Task[]
}

model Task {
  id              Int              @id @default(autoincrement())
  missionId       Int
  actionId        Int
  status          TaskStatus
  logs            String[]
  createdAt       DateTime         @default(now())
  followerActions FollowerAction[]
  action          Action           @relation(fields: [actionId], references: [id])
  mission         Mission          @relation(fields: [missionId], references: [id])

  @@unique([missionId, actionId])
}

model Action {
  id              Int              @id @default(autoincrement())
  name            String
  args            String
  blockNumber     Int
  orderInBlock    Int
  createdAt       DateTime         @default(now())
  positionKey     String
  address         String
  followerActions FollowerAction[]
  tasks           Task[]
}

model FollowerAction {
  id       Int    @id @default(autoincrement())
  actionId Int
  taskId   Int
  action   Action @relation(fields: [actionId], references: [id])
  task     Task   @relation(fields: [taskId], references: [id])

  @@unique([actionId, taskId])
}

model SLTPRequest {
  id          Int      @id @default(autoincrement())
  address     String
  contractId  Int
  positionKey String
  condition   String
  createdAt   DateTime @default(now())
  contract    Contract @relation(fields: [contractId], references: [id])
}

model GnsPricingRecord {
  id    Int      @id @default(autoincrement())
  pair  String
  price Float    @default(0)
  date  DateTime

  @@index([pair, date])
}

enum Platform {
  GNS
  GMX
  AVNT
}

enum Version {
  V9
  V10
  V2
  V1
}

enum ContractStatus {
  Live
  Dead
}

enum PnlSnapshotKind {
  DAY
  WEEK
  MONTH
  THREE_MONTH
  ALL_TIME
}

enum TradeActionType {
  TradeOpenedMarket
  TradeOpenedLimit
  TradeClosedMarket
  TradeClosedLIQ
  TradeClosedSL
  TradeClosedTP
  TradeLeverageUpdate
  TradePosSizeIncrease
  TradePosSizeDecrease
  TradePosPnlRealized
}

enum LogSeverity {
  Emergency
  Alert
  Critical
  Error
  Warning
  Notice
  Info
  Debug
  Default
}

enum UserPermission {
  Admin
  Trader
  Trial
}

enum BotStatus {
  Created
  Live
  Stop
  Dead
}

enum PlanStatus {
  Created
  Started
  Stopped
  Finished
}

enum MissionStatus {
  Opened
  Closed
  Created
  Opening
  Closing
  Ignored
}

enum MissionMode {
  Default
  Signal
  Hook
}

enum TaskStatus {
  Created
  Await
  Initiated
  Failed
  Completed
  Stopped
}

// ============================================
// BACKTEST OPTIMIZATION MODELS
// ============================================

enum BacktestTaskStatus {
  AWAIT
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum StrategyCategory {
  TREND_FOLLOWING
  MEAN_REVERSION
  BREAKOUT
  MOMENTUM
  VOLATILITY
  SCALPING
  SWING
  CUSTOM
}

enum TemplateSearchStatus {
  AWAIT
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

// ============================================
// VALIDATION PIPELINE ENUMS
// ============================================

enum ValidationPipelineStatus {
  CREATED
  LAYER_1_RUNNING
  LAYER_1_DONE
  LAYER_2_RUNNING
  LAYER_2_DONE
  LAYER_3_RUNNING
  LAYER_3_DONE
  AWAITING_USER_SELECTION
  LAYER_5_RUNNING
  LAYER_5_DONE
  AWAITING_FINAL_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum ValidationCandidateStatus {
  PENDING
  PASSED_THRESHOLD
  FAILED_THRESHOLD
  PARETO_OPTIMAL
  PARETO_DOMINATED
  WFA_PENDING
  WFA_PASSED
  WFA_FAILED
  USER_SELECTED
  USER_REJECTED
  ROBUSTNESS_PENDING
  ROBUSTNESS_PASSED
  ROBUSTNESS_FAILED
  FINAL_APPROVED
  FINAL_REJECTED
}

enum WalkForwardStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum RobustnessTestStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model StrategyTemplate {
  id            String           @id @default(uuid())
  name          String           @unique
  description   String?
  category      StrategyCategory
  factoryConfig Json             // Same structure as OptimizationParams
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  templateSearches TemplateSearch[]
  backtestTasks    BacktestTask[]

  @@index([category])
  @@index([isActive])
}

model TemplateSearch {
  id             String               @id @default(uuid())
  name           String
  templateId     String
  template       StrategyTemplate     @relation(fields: [templateId], references: [id])
  symbol         String               // Single symbol to test
  startDate      DateTime
  endDate        DateTime
  interval       String               @default("1m")
  searchStrategy String               @default("optuna")
  status         TemplateSearchStatus @default(AWAIT)
  createdAt      DateTime             @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?

  task                BacktestTask? // 1:1 relation with BacktestTask
  validationPipelines ValidationPipeline[]

  @@index([status, createdAt])
  @@index([templateId])
  @@index([symbol])
}

model BacktestTask {
  id     String @id @default(uuid())
  name   String // User-friendly name
  symbol String // e.g., "BTCUSDT"

  // Optimization parameters (JSON)
  // For grid: arrays like { fastPeriod: [10,20,30] }
  // For optuna: ranges like { fastPeriod: { min: 5, max: 50 } }
  optimizationParams Json

  // Date range for backtest
  startDate DateTime
  endDate   DateTime
  interval  String   @default("1m") // candle interval

  // Optimization method
  searchStrategy      String   @default("grid") // 'grid' | 'optuna'
  optimizationMetrics String[] @default(["sharpeRatio"]) // Metrics to optimize (multi-objective)
  trials              Int? // Number of Optuna trials (only for optuna)

  // Progress tracking
  status           BacktestTaskStatus @default(AWAIT)
  totalConfigs     Int                @default(0)
  processedConfigs Int                @default(0)
  currentConfig    String? // Current processing config UUID

  // Optuna results
  bestConfigIds String[] @default([]) // configIds of Pareto-optimal results
  optimizerPid  Int? // PID of running optimizer.py process (for cleanup)

  // Heartbeat tracking for optimizer connection management
  lastHeartbeat DateTime? // Last heartbeat timestamp from optimizer.py
  currentTrial  Int       @default(0) // Real-time trial progress (updated via heartbeat)
  trialProgress String?   // Trial phase: "sampling" | "evaluating" | "completed"

  // Timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Error tracking
  errorMessage String?

  // Relations
  results BacktestResult[]

  // Template relations (nullable for backwards compatibility)
  templateSearchId String?           @unique // 1:1 relation with TemplateSearch
  templateSearch   TemplateSearch?   @relation(fields: [templateSearchId], references: [id], onDelete: SetNull)
  templateId       String?
  template         StrategyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([symbol])
  @@index([searchStrategy])
  @@index([templateId])
}

model BacktestResult {
  id     String       @id @default(uuid())
  taskId String
  task   BacktestTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Result identification
  configId String // UUID for this specific config run
  runDate  String // yyyy-mm-dd format

  // Strategy config used
  strategyConfig Json // The full composable strategy config

  // Performance metrics
  totalTrades        Int
  winningTrades      Int
  losingTrades       Int
  winRate            Float
  totalPnlUsdt       Float
  totalPnlPercent    Float
  maxDrawdownUsdt    Float
  maxDrawdownPercent Float
  sharpeRatio        Float?
  profitFactor       Float?

  // File paths (relative to result folder)
  resultFolder String // result/[taskId]/[date]/[configId]

  createdAt DateTime @default(now())

  validationCandidates ValidationCandidate[]

  @@index([taskId, runDate])
  @@index([taskId, totalPnlUsdt])
  @@index([taskId, winRate])
}

// ============================================
// VALIDATION PIPELINE MODELS
// ============================================

model ValidationPipeline {
  id               String                   @id @default(uuid())
  name             String
  templateSearchId String
  templateSearch   TemplateSearch           @relation(fields: [templateSearchId], references: [id])
  status           ValidationPipelineStatus @default(CREATED)

  // Layer 1: Threshold config
  thresholdConfig Json // { minSharpe: 1.0, maxDrawdown: 20, minWinRate: 0.4, ... }

  // Layer 2: Pareto config
  paretoMetrics String[] // ["sharpeRatio", "totalPnlPercent", "maxDrawdownPercent"]

  // Layer 3: WFA config
  wfaTrainRatio     Float @default(0.7) // 70% train, 30% test
  wfaWindows        Int   @default(3) // Number of walk-forward windows
  wfaMinConsistency Float @default(0.6) // Min consistency score to pass

  // Layer 5: Robustness config
  robustnessSteps    Int   @default(10) // Number of startDate iterations
  robustnessMinScore Float @default(0.7) // Min stability score to pass

  // Stats
  totalCandidates  Int @default(0)
  passedThreshold  Int @default(0)
  paretoOptimal    Int @default(0)
  passedWfa        Int @default(0)
  userSelected     Int @default(0)
  passedRobustness Int @default(0)
  finalApproved    Int @default(0)

  // Timestamps
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  candidates ValidationCandidate[]

  @@index([status])
  @@index([templateSearchId])
}

model ValidationCandidate {
  id         String                    @id @default(uuid())
  pipelineId String
  pipeline   ValidationPipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  resultId   String
  result     BacktestResult            @relation(fields: [resultId], references: [id])
  configId   String // Reference to original config
  status     ValidationCandidateStatus @default(PENDING)

  // Layer 1 results
  thresholdPassed  Boolean?
  thresholdDetails Json? // { sharpeRatio: { value: 1.5, passed: true }, ... }

  // Layer 2 results
  paretoRank  Int? // 0 = Pareto front, 1+ = dominated
  dominatedBy String[] // IDs of candidates that dominate this one

  // Layer 3 results (aggregated from WalkForwardResult)
  wfaConsistency Float? // Overall consistency score 0-1
  wfaPassed      Boolean?

  // Layer 4 results
  userSelectedAt DateTime?
  userNotes      String?

  // Layer 5 results (aggregated from RobustnessTest)
  robustnessScore  Float? // Overall stability score 0-1
  robustnessPassed Boolean?

  // Layer 6 results
  finalApprovedAt DateTime?
  finalNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walkForwardResults WalkForwardResult[]
  robustnessTests    RobustnessTest[]

  @@unique([pipelineId, resultId])
  @@index([pipelineId, status])
  @@index([resultId])
}

model WalkForwardResult {
  id          String              @id @default(uuid())
  candidateId String
  candidate   ValidationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  windowIndex Int // 0, 1, 2, ...
  status      WalkForwardStatus   @default(PENDING)

  // Train period
  trainStart   DateTime
  trainEnd     DateTime
  trainMetrics Json? // Metrics from training period

  // Test period
  testStart   DateTime
  testEnd     DateTime
  testMetrics Json? // Metrics from test period

  // Comparison
  consistency Float? // How well test matches train (0-1)
  degradation Float? // Performance drop from train to test

  errorMessage String?
  createdAt    DateTime @default(now())

  @@unique([candidateId, windowIndex])
  @@index([candidateId])
}

model RobustnessTest {
  id          String               @id @default(uuid())
  candidateId String
  candidate   ValidationCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stepIndex   Int // 0, 1, 2, ... (startDate iteration)
  status      RobustnessTestStatus @default(PENDING)

  // Sliding window
  startDate DateTime // Shifted startDate
  endDate   DateTime // Fixed endDate

  // Results
  metrics     Json? // Backtest metrics for this window
  sharpeRatio Float?
  totalPnl    Float?
  maxDrawdown Float?

  errorMessage String?
  createdAt    DateTime @default(now())

  @@unique([candidateId, stepIndex])
  @@index([candidateId])
}
