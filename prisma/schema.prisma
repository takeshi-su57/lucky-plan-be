// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// system level models

model Metadata {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StrategyMetadata {
  key         String @id @db.VarChar(255)
  title       String @db.VarChar(255)
  description String

  strategies Strategy[]
}

model Strategy {
  id                 Int    @id @default(autoincrement())
  strategyKey        String
  ratio              Int    @default(100)
  lifeTime           Int // unit is min
  minCollateral      Int // usdc
  maxCollateral      Int // usdc
  collateralBaseline Int // usdc
  maxLeverage        Int    @default(200000)
  minLeverage        Int    @default(1100)
  params             String

  strategyMetadata StrategyMetadata @relation(fields: [strategyKey], references: [key])

  bots Bot[]
}

enum ContractStatus {
  Live
  Dead
}

model Contract {
  id                         Int            @id @default(autoincrement())
  chainId                    Int
  address                    String
  description                String
  isTestnet                  Boolean        @default(false)
  lastBlockNumber            Int
  lastLeaderboardBlockNumber Int            @default(0)
  backendUrl                 String?
  status                     ContractStatus @default(Live)

  leaderBots   Bot[]      @relation("leaderBots")
  followerBots Bot[]      @relation("followerBots")
  positions    Position[]

  @@unique([chainId, address])
}

enum TradeActionType {
  TradeOpenedMarket
  TradeOpenedLimit
  TradeClosedMarket
  TradeClosedLIQ
  TradeClosedSL
  TradeClosedTP
  TradeLeverageUpdate
  TradePosSizeIncrease
  TradePosSizeDecrease
}

model TradeHistory {
  id                 Int             @id @default(autoincrement())
  address            String
  action             TradeActionType
  contractId         Int
  pair               String
  price              String
  collateralPriceUsd String
  long               Int
  size               String
  leverage           Int
  pnl                String
  collateralIndex    Int
  tradeIndex         Int
  collateralDelta    String?
  leverageDelta      Int?
  marketPrice        String?
  tradeId            String?
  block              Int
  date               DateTime

  @@index([address, contractId, block(sort: Asc)])
}

enum PnlSnapshotKind {
  DAY
  TWO_DAY
  THREE_DAY
  WEEK
  TWO_WEEK
  MONTH
  THREE_MONTH
  HALF_YEAR
  YEAR
  ALL_TIME
}

model PnlSnapshot {
  id         Int             @id @default(autoincrement())
  address    String
  contractId Int
  dateStr    String // YYYY-MM-DD
  kind       PnlSnapshotKind
  accUSDPnl  Float

  @@unique([address, contractId, dateStr, kind])
  @@index([accUSDPnl(sort: Desc)])
}

model PnlSnapshotInitializedFlag {
  id      Int     @id @default(autoincrement())
  dateStr String  @unique // YYYY-MM-DD
  isInit  Boolean @default(false)
}

enum LogSeverity {
  Emergency
  Alert
  Critical
  Error
  Warning
  Notice
  Info
  Debug
  Default
}

model Log {
  id        Int         @id @default(autoincrement())
  severity  LogSeverity
  timestamp DateTime    @default(now())
  summary   String
  details   String?
  checked   Boolean     @default(false)

  @@index([severity, timestamp(sort: Desc)])
}

// bot level models

enum UserPermission {
  Admin
  Trader
  Trial
}

model User {
  address    String         @unique
  mnemonic   String
  permission UserPermission
}

enum BotStatus {
  Created
  Live
  Stop
  Dead
}

model TagCategory {
  id          Int    @id @default(autoincrement())
  category    String @unique()
  description String

  Tag Tag[]
}

model Tag {
  tag         String @id @db.VarChar(255)
  description String
  color       String
  categoryId  Int?

  category TagCategory?    @relation(fields: [categoryId], references: [id])
  wallets  WalletAccount[]
}

model WalletAccount {
  address String @id @db.VarChar(255)
  tags    Tag[]
}

model Follower {
  address      String @id @db.VarChar(255)
  publicKey    String @unique
  accountIndex Int    @unique // this is master follower

  bots Bot[]
}

enum PlanStatus {
  Created
  Started
  Stopped
  Finished
}

model Plan {
  id             Int        @id @default(autoincrement())
  title          String
  description    String
  startedAt      DateTime?
  endedAt        DateTime?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         PlanStatus
  bots           Bot[]
}

model Bot {
  id                       Int       @id @default(autoincrement())
  leaderAddress            String    @db.VarChar(255)
  followerAddress          String    @db.VarChar(255)
  planId                   Int?
  strategyId               Int
  leaderContractId         Int
  leaderCollateralBaseline Int
  leaderStartedBlock       Int?
  leaderEndedBlock         Int?
  followerContractId       Int
  followerStartedBlock     Int?
  followerEndedBlock       Int?
  startedAt                DateTime?
  endedAt                  DateTime?
  status                   BotStatus @default(Created)

  plan             Plan?    @relation(fields: [planId], references: [id])
  follower         Follower @relation(fields: [followerAddress], references: [address])
  strategy         Strategy @relation(fields: [strategyId], references: [id])
  leaderContract   Contract @relation("leaderBots", fields: [leaderContractId], references: [id])
  followerContract Contract @relation("followerBots", fields: [followerContractId], references: [id])

  missions Mission[]
}

model Position {
  id         Int    @id @default(autoincrement())
  contractId Int
  address    String @db.VarChar(255)
  index      Int

  contract        Contract  @relation(fields: [contractId], references: [id])
  targetMissions  Mission[] @relation("targetMissions")
  achieveMissions Mission[] @relation("achieveMissions")
  actions         Action[]

  @@unique([contractId, address, index])
}

enum MissionStatus {
  Created
  Opening
  Opened
  Closing
  Closed
  Ignored
}

model Mission {
  id                Int           @id @default(autoincrement())
  botId             Int
  targetPositionId  Int
  achievePositionId Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  status            MissionStatus

  targetPosition  Position  @relation("targetMissions", fields: [targetPositionId], references: [id])
  achievePosition Position? @relation("achieveMissions", fields: [achievePositionId], references: [id])
  bot             Bot       @relation(fields: [botId], references: [id])
  tasks           Task[]

  @@unique([botId, targetPositionId])
}

enum TaskStatus {
  Created
  Await
  Initiated
  Failed
  Stopped
  Completed
}

model Task {
  id        Int        @id @default(autoincrement())
  missionId Int
  actionId  Int
  status    TaskStatus
  logs      String[]
  createdAt DateTime   @default(now())

  action          Action           @relation(fields: [actionId], references: [id])
  mission         Mission          @relation(fields: [missionId], references: [id])
  followerActions FollowerAction[]

  @@unique([missionId, actionId])
}

model Action {
  id           Int      @id @default(autoincrement())
  name         String
  positionId   Int
  args         String
  blockNumber  Int
  orderInBlock Int
  createdAt    DateTime @default(now())

  position       Position        @relation(fields: [positionId], references: [id])
  tasks          Task[]
  followerAction FollowerAction?
}

model FollowerAction {
  id       Int @id @default(autoincrement())
  actionId Int @unique
  taskId   Int

  action Action @relation(fields: [actionId], references: [id])
  task   Task   @relation(fields: [taskId], references: [id])

  @@unique([actionId, taskId])
}
