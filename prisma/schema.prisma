generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Metadata {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StrategyMetadata {
  key         String     @id @db.VarChar(255)
  title       String     @db.VarChar(255)
  description String
  strategies  Strategy[]
}

model Strategy {
  id                 Int              @id @default(autoincrement())
  strategyKey        String
  params             String
  maxLeverage        Int              @default(200000)
  minLeverage        Int              @default(1100)
  ratio              Float            @default(1)
  maxCollateral      Int
  minCollateral      Int
  lifeTime           Int
  collateralBaseline Int
  bots               Bot[]
  strategyMetadata   StrategyMetadata @relation(fields: [strategyKey], references: [key])
}

model Contract {
  id                         Int            @id @default(autoincrement())
  chainId                    Int
  address                    String
  description                String
  lastBlockNumber            Int
  status                     ContractStatus @default(Live)
  lastLeaderboardBlockNumber Int            @default(0)
  backendUrl                 String?
  isTestnet                  Boolean        @default(false)
  fromBlock                  Int            @default(0)
  platform                   Platform       @default(GNS)
  toBlock                    Int?
  version                    Version        @default(V9)
  followerBots               Bot[]          @relation("followerBots")
  leaderBots                 Bot[]          @relation("leaderBots")
  sltprequests               SLTPRequest[]

  @@unique([chainId, address, version, platform])
}

model JupPerpEventLog {
  id        Int      @id @default(autoincrement())
  jsonLog   String
  slot      Int
  signature String
  date      DateTime

  @@index([signature])
}

model EventLog {
  id         Int      @id @default(autoincrement())
  contractId Int
  jsonLog    String
  block      Int
  logIndex   Int
  date       DateTime

  @@unique([contractId, block, logIndex])
}

model PerpTradingEventLog {
  id         Int      @id @default(autoincrement())
  contractId Int
  jsonLog    String
  usdPnl     Float
  block      Int
  logIndex   Int
  date       DateTime
  address    String
  platform   Platform

  @@unique([address, contractId, block, logIndex])
  @@index([platform, contractId, date, block, id])
}

model TradingSignalLog {
  id          Int      @id @default(autoincrement())
  platform    Platform
  address     String
  eventLogIds Int[]

  @@unique([platform, address])
}

model PnlSnapshotV2 {
  id        Int             @id @default(autoincrement())
  platform  Platform
  address   String
  dateStr   String
  kind      PnlSnapshotKind
  accUSDPnl Float

  @@unique([address, platform, dateStr, kind])
  @@index([accUSDPnl(sort: Desc)])
  @@index([dateStr, platform, id])
  @@index([platform])
}

model PnlSnapshotV2InitializedFlag {
  id       Int      @id @default(autoincrement())
  dateStr  String
  isInit   Boolean  @default(false)
  platform Platform

  @@unique([platform, dateStr])
}

model TradeHistory {
  id                 Int             @id @default(autoincrement())
  address            String
  contractId         Int
  pnl                String
  action             TradeActionType
  block              Int
  collateralDelta    String?
  collateralIndex    Int
  collateralPriceUsd String
  date               DateTime
  leverage           Int
  long               Int
  marketPrice        String?
  pair               String
  price              String
  size               String
  tradeId            String?
  tradeIndex         Int
  leverageDelta      Int?
  isCounterTrade     Boolean?        @default(false)
  meta               String?

  @@index([address, contractId, block])
}

model PnlSnapshot {
  id         Int             @id @default(autoincrement())
  address    String
  kind       PnlSnapshotKind
  accUSDPnl  Float
  dateStr    String
  contractId Int

  @@unique([address, contractId, dateStr, kind])
  @@index([accUSDPnl(sort: Desc)])
}

model TestingReport {
  id                 Int     @id @default(autoincrement())
  minR2              Float
  investedUSD        Float
  totalUSDPnl        Float
  totalTasks         Int
  totalPositions     Int
  totalTraders       Int
  totalUniqueTraders Int
  calculatedR2       Float
  calculatedSlope    Float
  maxLoss            Float
  avgLoss            Float
  maxProfit          Float
  avgProfit          Float
  peakAccProfit      Float
  bottomAccProfit    Float
  usdPnls            Float[]
  lossCount          Int
  profitCount        Int
  allTimeWeight      Int
  m                  Int
  maxAvgSize         Int
  maxCount           Int
  minAvgSize         Int
  minCount           Int
  minScore           Float
  monthWeight        Int
  n                  Int
  threeMonthWeight   Int
  weekWeight         Int
  window             Int
}

model PnlSnapshotInitializedFlag {
  id      Int     @id @default(autoincrement())
  dateStr String  @unique
  isInit  Boolean @default(false)
}

model Log {
  id        Int         @id @default(autoincrement())
  severity  LogSeverity
  timestamp DateTime    @default(now())
  summary   String
  details   String?
  checked   Boolean     @default(false)

  @@index([severity, timestamp(sort: Desc)])
}

model User {
  address            String         @unique
  mnemonic           String
  permission         UserPermission
  allowAuto          Boolean        @default(false)
  budget             Float          @default(0)
  ratio              Float          @default(1)
  followerContractId Int            @default(0)
}

model TagCategory {
  id          Int    @id @default(autoincrement())
  category    String
  description String
  userId      String
  Tag         Tag[]

  @@unique([userId, category])
}

model Tag {
  tag         String
  color       String
  description String
  categoryId  Int?
  id          Int             @id @default(autoincrement())
  userId      String
  category    TagCategory?    @relation(fields: [categoryId], references: [id])
  wallets     WalletAccount[] @relation("TagToWalletAccount")

  @@unique([userId, tag])
}

model WalletAccount {
  address String
  id      Int    @id @default(autoincrement())
  userId  String
  tags    Tag[]  @relation("TagToWalletAccount")

  @@unique([userId, address])
}

model Follower {
  address      String @id @db.VarChar(255)
  publicKey    String @unique
  accountIndex Int
  userId       String @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots         Bot[]

  @@unique([userId, accountIndex])
}

model Plan {
  id             Int        @id @default(autoincrement())
  title          String
  description    String
  startedAt      DateTime?
  endedAt        DateTime?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         PlanStatus
  userId         String     @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots           Bot[]
}

model Bot {
  id                       Int       @id @default(autoincrement())
  leaderAddress            String    @db.VarChar(255)
  followerAddress          String    @db.VarChar(255)
  strategyId               Int
  status                   BotStatus @default(Created)
  leaderContractId         Int
  followerContractId       Int
  followerEndedBlock       Int?
  followerStartedBlock     Int?
  leaderEndedBlock         Int?
  leaderStartedBlock       Int?
  endedAt                  DateTime?
  startedAt                DateTime?
  leaderCollateralBaseline Int
  planId                   Int       @default(0)
  follower                 Follower  @relation(fields: [followerAddress], references: [address])
  followerContract         Contract  @relation("followerBots", fields: [followerContractId], references: [id])
  leaderContract           Contract  @relation("leaderBots", fields: [leaderContractId], references: [id])
  plan                     Plan      @relation(fields: [planId], references: [id])
  strategy                 Strategy  @relation(fields: [strategyId], references: [id])
  missions                 Mission[]
}

model Mission {
  id                         Int           @id @default(autoincrement())
  botId                      Int
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  status                     MissionStatus
  achievePositionKey         String?
  targetPositionKey          String
  achievePositionBlockNumber Int?
  achievePositionLogIndex    Int?
  targetPositionBlockNumber  Int
  targetPositionLogIndex     Int
  mode                       MissionMode   @default(Default)
  bot                        Bot           @relation(fields: [botId], references: [id])
  tasks                      Task[]
}

model Task {
  id              Int              @id @default(autoincrement())
  missionId       Int
  actionId        Int
  status          TaskStatus
  logs            String[]
  createdAt       DateTime         @default(now())
  followerActions FollowerAction[]
  action          Action           @relation(fields: [actionId], references: [id])
  mission         Mission          @relation(fields: [missionId], references: [id])

  @@unique([missionId, actionId])
}

model Action {
  id              Int              @id @default(autoincrement())
  name            String
  args            String
  blockNumber     Int
  orderInBlock    Int
  createdAt       DateTime         @default(now())
  positionKey     String
  address         String
  followerActions FollowerAction[]
  tasks           Task[]
}

model FollowerAction {
  id       Int    @id @default(autoincrement())
  actionId Int
  taskId   Int
  action   Action @relation(fields: [actionId], references: [id])
  task     Task   @relation(fields: [taskId], references: [id])

  @@unique([actionId, taskId])
}

model SLTPRequest {
  id          Int      @id @default(autoincrement())
  address     String
  contractId  Int
  positionKey String
  condition   String
  createdAt   DateTime @default(now())
  contract    Contract @relation(fields: [contractId], references: [id])

  @@unique([address, contractId, positionKey])
}

model GnsPricingRecord {
  id    Int      @id @default(autoincrement())
  pair  String
  price Float    @default(0)
  date  DateTime

  @@index([pair, date])
}

enum Platform {
  GNS
  GMX
  AVNT
}

enum Version {
  V9
  V10
  V2
  V1
}

enum ContractStatus {
  Live
  Dead
}

enum PnlSnapshotKind {
  DAY
  WEEK
  MONTH
  THREE_MONTH
  ALL_TIME
}

enum TradeActionType {
  TradeOpenedMarket
  TradeOpenedLimit
  TradeClosedMarket
  TradeClosedLIQ
  TradeClosedSL
  TradeClosedTP
  TradeLeverageUpdate
  TradePosSizeIncrease
  TradePosSizeDecrease
  TradePosPnlRealized
}

enum LogSeverity {
  Emergency
  Alert
  Critical
  Error
  Warning
  Notice
  Info
  Debug
  Default
}

enum UserPermission {
  Admin
  Trader
  Trial
}

enum BotStatus {
  Created
  Live
  Stop
  Dead
}

enum PlanStatus {
  Created
  Started
  Stopped
  Finished
}

enum MissionStatus {
  Opened
  Closed
  Created
  Opening
  Closing
  Ignored
}

enum MissionMode {
  Default
  Signal
}

enum TaskStatus {
  Created
  Await
  Initiated
  Failed
  Completed
  Stopped
}
