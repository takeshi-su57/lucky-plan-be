generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Metadata {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Strategy {
  id              Int    @id @default(autoincrement())
  tpPercentage    Float  @default(0)
  slPercentage    Float  @default(0)
  maxOpenMissions Int    @default(0)
  selectedPairs   String @default("[]")
  mode            String @default("default")
  maxLeverage     Int    @default(200000)
  minLeverage     Int    @default(1100)
  ratio           Float  @default(1)
  maxCollateral   Int
  minCollateral   Int
  lifeTime        Int
  bots            Bot[]
}

model Contract {
  id                         Int            @id @default(autoincrement())
  chainId                    Int
  address                    String
  description                String
  lastBlockNumber            Int
  status                     ContractStatus @default(Live)
  lastLeaderboardBlockNumber Int            @default(0)
  backendUrl                 String?
  fromBlock                  Int            @default(0)
  platform                   Platform       @default(GNS)
  toBlock                    Int?
  version                    Version        @default(V9)
  followerBots               Bot[]          @relation("followerBots")
  leaderBots                 Bot[]          @relation("leaderBots")
  sltprequests               SLTPRequest[]

  @@unique([chainId, address, version, platform])
}

model PerpTradingEventLog {
  id         Int      @id @default(autoincrement())
  contractId Int
  jsonLog    String
  usdPnl     Float
  block      Int
  logIndex   Int
  date       DateTime
  address    String
  platform   Platform

  @@unique([address, contractId, block, logIndex])
  @@index([platform, address, date, block, id])
  @@index([platform, date, block, id])
}

model PnlSnapshotV2 {
  platform  Platform
  address   String
  dateStr   String
  accUSDPnl Float

  @@id([address, platform, dateStr])
  @@index([dateStr, platform, accUSDPnl(sort: Desc), address(sort: Asc)])
}

model PnlSnapshotV2InitializedFlag {
  id       Int      @id @default(autoincrement())
  dateStr  String
  isInit   Boolean  @default(false)
  platform Platform

  @@unique([platform, dateStr])
}

model Log {
  id        Int         @id @default(autoincrement())
  severity  LogSeverity
  timestamp DateTime    @default(now())
  summary   String
  details   String?
  checked   Boolean     @default(false)

  @@index([severity, timestamp(sort: Desc)])
}

model User {
  address            String         @unique
  secondAddress      String?        @unique
  mnemonic           String
  permission         UserPermission
  allowAuto          Boolean        @default(false)
  budget             Float          @default(0)
  ratio              Float          @default(1)
  followerContractId Int            @default(0)
}

model Follower {
  address      String @id @db.VarChar(255)
  publicKey    String @unique
  accountIndex Int
  userId       String @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots         Bot[]

  @@unique([userId, accountIndex])
}

model Plan {
  id             Int        @id @default(autoincrement())
  title          String
  description    String
  startedAt      DateTime?
  endedAt        DateTime?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         PlanStatus
  userId         String     @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots           Bot[]
}

enum BotMode {
  Default
  Reversed
}

model Bot {
  id                       Int       @id @default(autoincrement())
  leaderAddress            String    @db.VarChar(255)
  followerAddress          String    @db.VarChar(255)
  strategyId               Int
  status                   BotStatus @default(Created)
  leaderContractId         Int
  followerContractId       Int
  followerEndedBlock       Int?
  followerStartedBlock     Int?
  leaderEndedBlock         Int?
  leaderStartedBlock       Int?
  endedAt                  DateTime?
  startedAt                DateTime?
  leaderCollateralBaseline Int
  planId                   Int       @default(0)
  mode                     BotMode   @default(Default)

  follower         Follower  @relation(fields: [followerAddress], references: [address])
  followerContract Contract  @relation("followerBots", fields: [followerContractId], references: [id])
  leaderContract   Contract  @relation("leaderBots", fields: [leaderContractId], references: [id])
  plan             Plan      @relation(fields: [planId], references: [id])
  strategy         Strategy  @relation(fields: [strategyId], references: [id])
  missions         Mission[]
}

model Mission {
  id                         Int           @id @default(autoincrement())
  botId                      Int
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  status                     MissionStatus
  achievePositionKey         String?
  targetPositionKey          String
  achievePositionBlockNumber Int?
  achievePositionLogIndex    Int?
  targetPositionBlockNumber  Int
  targetPositionLogIndex     Int
  mode                       MissionMode   @default(Default)
  bot                        Bot           @relation(fields: [botId], references: [id])
  tasks                      Task[]
}

model Task {
  id              Int              @id @default(autoincrement())
  missionId       Int
  actionId        Int
  status          TaskStatus
  logs            String[]
  createdAt       DateTime         @default(now())
  followerActions FollowerAction[]
  action          Action           @relation(fields: [actionId], references: [id])
  mission         Mission          @relation(fields: [missionId], references: [id])

  @@unique([missionId, actionId])
}

model Action {
  id              Int              @id @default(autoincrement())
  name            String
  args            String
  blockNumber     Int
  orderInBlock    Int
  createdAt       DateTime         @default(now())
  positionKey     String
  address         String
  followerActions FollowerAction[]
  tasks           Task[]
}

model FollowerAction {
  id       Int    @id @default(autoincrement())
  actionId Int
  taskId   Int
  action   Action @relation(fields: [actionId], references: [id])
  task     Task   @relation(fields: [taskId], references: [id])

  @@unique([actionId, taskId])
}

model SLTPRequest {
  id          Int      @id @default(autoincrement())
  address     String
  contractId  Int
  positionKey String
  condition   String
  createdAt   DateTime @default(now())
  contract    Contract @relation(fields: [contractId], references: [id])
}

model GnsPricingRecord {
  id    Int      @id @default(autoincrement())
  pair  String
  price Float    @default(0)
  date  DateTime

  @@index([pair, date])
}

enum Platform {
  GNS
  GMX
  AVNT
}

enum Version {
  V9
  V10
  V2
  V1
}

enum ContractStatus {
  Live
  Dead
}

enum TradeActionType {
  TradeOpenedMarket
  TradeOpenedLimit
  TradeClosedMarket
  TradeClosedLIQ
  TradeClosedSL
  TradeClosedTP
  TradeLeverageUpdate
  TradePosSizeIncrease
  TradePosSizeDecrease
  TradePosPnlRealized
}

enum LogSeverity {
  Emergency
  Alert
  Critical
  Error
  Warning
  Notice
  Info
  Debug
  Default
}

enum UserPermission {
  Admin
  Trader
  Trial
}

enum BotStatus {
  Created
  Live
  Stop
  Dead
}

enum PlanStatus {
  Created
  Started
  Stopped
  Finished
}

enum MissionStatus {
  Opened
  Closed
  Created
  Opening
  Closing
  Ignored
}

enum MissionMode {
  Default
  Signal
  Hook
}

enum TaskStatus {
  Created
  Await
  Initiated
  Failed
  Completed
  Stopped
}
