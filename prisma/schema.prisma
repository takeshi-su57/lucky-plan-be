generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Metadata {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StrategyMode {
  Default
  Signal
}

model Strategy {
  id              Int          @id @default(autoincrement())
  tpPercentage    Float        @default(0)
  slPercentage    Float        @default(0)
  maxOpenMissions Int          @default(0)
  selectedPairs   String       @default("[]")
  mode            StrategyMode @default(Default)
  maxLeverage     Int          @default(200000)
  minLeverage     Int          @default(1100)
  ratio           Float        @default(1)
  maxCollateral   Int
  minCollateral   Int
  lifeTime        Int

  bots Bot[]
}

model Contract {
  id                         Int            @id @default(autoincrement())
  chainId                    Int
  address                    String
  description                String
  lastBlockNumber            Int
  status                     ContractStatus @default(Live)
  lastLeaderboardBlockNumber Int            @default(0)
  backendUrl                 String?
  fromBlock                  Int            @default(0)
  platform                   Platform       @default(GNS)
  toBlock                    Int?
  version                    Version        @default(V9)
  followerBots               Bot[]          @relation("followerBots")
  leaderBots                 Bot[]          @relation("leaderBots")
  sltprequests               SLTPRequest[]
  actions                    Action[]

  @@unique([chainId, address, version, platform])
}

model PerpTradingEventLog {
  contractId      Int
  jsonLog         String
  usdPnl          Float
  block           Int
  logIndex        Int
  transactionHash String
  date            DateTime
  address         String
  platform        Platform

  @@id([contractId, block, logIndex])
  @@index([platform, address, date, block, logIndex, contractId])
  @@index([platform, date, block, logIndex, contractId])
}

model PnlSnapshotV2 {
  platform  Platform
  address   String
  dateStr   String
  accUSDPnl Float

  @@id([address, platform, dateStr])
  @@index([dateStr, platform, accUSDPnl(sort: Desc), address(sort: Asc)])
}

model PnlSnapshotV2InitializedFlag {
  id       Int      @id @default(autoincrement())
  dateStr  String
  isInit   Boolean  @default(false)
  platform Platform

  @@unique([platform, dateStr])
}

model Log {
  id        Int         @id @default(autoincrement())
  severity  LogSeverity
  timestamp DateTime    @default(now())
  summary   String
  details   String?
  checked   Boolean     @default(false)

  @@index([severity, timestamp(sort: Desc)])
}

model User {
  address            String         @unique
  secondAddress      String?        @unique
  mnemonic           String
  permission         UserPermission
  allowAuto          Boolean        @default(false)
  budget             Float          @default(0)
  ratio              Float          @default(1)
  followerContractId Int            @default(0)
}

model Follower {
  address      String @id @db.VarChar(255)
  publicKey    String @unique
  accountIndex Int
  userId       String @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots         Bot[]

  @@unique([userId, accountIndex])
}

model Plan {
  id             Int        @id @default(autoincrement())
  title          String
  description    String
  startedAt      DateTime?
  endedAt        DateTime?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         PlanStatus
  userId         String     @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots           Bot[]
}

model SimulationPlan {
  id                     Int      @id @default(autoincrement())
  title                  String
  description            String
  startAt                DateTime
  endAt                  DateTime
  cursor                 DateTime
  simulationId           Int?
  sourceSimulationPlanId Int?

  openedPositions  Int   @default(0)
  totalPositions   Int   @default(0)
  totalLeaderPnl   Float @default(0)
  totalFollowerPnl Float @default(0)

  simulationBots         SimulationBot[]
  simulation             Simulation?               @relation(fields: [simulationId], references: [id])
  cache                  SimulationPlanCache?
  evaluatorTasks         SimulationEvaluatorTask[]
  sourceSimulationPlan   SimulationPlan?           @relation("SimulationPlanVariants", fields: [sourceSimulationPlanId], references: [id], onDelete: SetNull)
  derivedSimulationPlans SimulationPlan[]          @relation("SimulationPlanVariants")

  @@index([simulationId, startAt])
  @@index([sourceSimulationPlanId])
}

model SimulationResearch {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  platform    Platform
  startAt     DateTime
  endAt       DateTime
  days        Int      @default(1)
  gapDays     Int      @default(0)
  direction   BotMode  @default(Reversed)
  trade       Json     @default("[]")
  r2          Json     @default("[]")
  slope       Json     @default("[]")

  collateral                Json   @default("[]")
  size                      Json   @default("[]")
  leverage                  Json   @default("[]")
  leaderExecutionCollateral Json   @default("[]")
  leaderExecutionSize       Json   @default("[]")
  leaderExecutionLeverage   Json   @default("[]")
  followerRiskSize          Json   @default("[]")
  followerRiskCollateral    Json   @default("[]")
  score                     Json   @default("[]")
  scoreFormular             String @default("RiskAdjustedCopyScore")
  sizingFormular            String @default("ScoreScaledCollateralSizing")
  sourceSimulationId        Int?

  cursor                   DateTime?
  status                   SimulationStatus @default(Created)
  progressPhase            String?
  progressMessage          String?
  progressPercent          Float            @default(0)
  totalRanges              Int              @default(0)
  completedRanges          Int              @default(0)
  totalPlans               Int              @default(0)
  completedPlans           Int              @default(0)
  outstandingPlans         Int              @default(0)
  queuedPlans              Int              @default(0)
  runningPlans             Int              @default(0)
  finalizingPlans          Int              @default(0)
  startedAt                DateTime?
  finishedAt               DateTime?
  lastError                String?
  retryAttempts            Int              @default(0)
  nextRetryAt              DateTime?
  automationEnabled        Boolean          @default(true)
  automationLeaseToken     String?          @db.VarChar(64)
  automationLeaseExpiresAt DateTime?

  simulations      Simulation[]
  sourceSimulation Simulation?  @relation("SimulationResearchSource", fields: [sourceSimulationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@index([automationEnabled, status, nextRetryAt])
  @@index([status, automationLeaseExpiresAt])
  @@index([createdAt])
  @@index([sourceSimulationId])
}

enum BotMode {
  Default
  Reversed
}

enum SimulationStatus {
  Created
  Queued
  Running
  Paused
  Completed
  Failed
  Cancelled
}

enum SimulationEvaluatorTaskKind {
  EvaluateLeaders
  PrebuildPlatformCache
  SetWorkerCapacity
}

enum SimulationEvaluatorTaskStatus {
  Queued
  Ready
  Claimed
  Completed
  Failed
  Cancelled
}

enum SimulationExecutionPlanStatus {
  Pending
  Dispatched
  Finalizing
  Completed
  Failed
  Cancelled
}

enum SimulationEvaluatorWorkerAuthorizationStatus {
  Pending
  Approved
  Rejected
  Disabled
}

enum SimulationEvaluatorWorkerRuntimeStatus {
  Offline
  Online
  Free
  Busy
  Prebuilding
  Paused
}

enum SimulationEvaluatorWorkerDesiredState {
  Running
  Draining
  Paused
}

enum SimulationEvaluatorWorkerPlatformCacheStatus {
  Missing
  Queued
  Building
  Ready
  Failed
}

model SimulationEvaluatorWorker {
  id                  String                                       @id
  displayName         String?
  publicKey           String?                                      @unique
  authorizationStatus SimulationEvaluatorWorkerAuthorizationStatus @default(Pending)
  runtimeStatus       SimulationEvaluatorWorkerRuntimeStatus       @default(Offline)
  desiredState        SimulationEvaluatorWorkerDesiredState        @default(Running)
  desiredCapacity     Int                                          @default(1)
  activeCapacity      Int                                          @default(1)
  lastHeartbeatAt     DateTime?
  lastTaskAt          DateTime?
  lastError           String?
  lastDiagnostic      Json?
  lastDiagnosticAt    DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  disabledAt          DateTime?
  createdAt           DateTime                                     @default(now())
  updatedAt           DateTime                                     @updatedAt

  platformCaches SimulationEvaluatorWorkerPlatformCache[]

  @@index([authorizationStatus, runtimeStatus, lastHeartbeatAt])
}

model SimulationEvaluatorWorkerPlatformCache {
  id              Int                                          @id @default(autoincrement())
  workerId        String
  platform        Platform
  status          SimulationEvaluatorWorkerPlatformCacheStatus @default(Missing)
  coveredStartAt  DateTime?
  coveredEndAt    DateTime?
  buildingStartAt DateTime?
  buildingEndAt   DateTime?
  lastError       String?
  lastBuiltAt     DateTime?
  createdAt       DateTime                                     @default(now())
  updatedAt       DateTime                                     @updatedAt

  worker SimulationEvaluatorWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, platform, coveredStartAt, coveredEndAt])
  @@index([platform, status, coveredStartAt, coveredEndAt])
}

model SimulationEvaluatorDispatcher {
  id              String   @id
  lastHeartbeatAt DateTime
  updatedAt       DateTime @updatedAt
}

model Simulation {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  platform Platform

  researchId         Int?
  sourceSimulationId Int?
  direction          BotMode @default(Reversed)

  startAt                  DateTime
  endAt                    DateTime
  days                     Int              @default(1)
  gapDays                  Int              @default(0)
  cursor                   DateTime?
  status                   SimulationStatus @default(Created)
  progressPhase            String?
  progressMessage          String?
  progressPercent          Float            @default(0)
  automationLeaseToken     String?          @db.VarChar(64)
  automationLeaseExpiresAt DateTime?

  selectedLeaderCount Int  @default(10)
  trade               Json @default("{\"min\":3,\"max\":1000000}")
  r2                  Json @default("{\"min\":0.5,\"max\":1}")
  slope               Json @default("{\"min\":0,\"max\":1000000000}")

  standardCollateralUsd     Float  @default(100)
  collateral                Json   @default("{\"min\":0,\"max\":1000000000}")
  size                      Json   @default("{\"min\":0,\"max\":1000000000}")
  leverage                  Json   @default("{\"min\":0,\"max\":50}")
  leaderExecutionCollateral Json   @default("{\"min\":0,\"max\":1000000000}")
  leaderExecutionSize       Json   @default("{\"min\":0,\"max\":1000000000}")
  leaderExecutionLeverage   Json   @default("{\"min\":0,\"max\":50}")
  followerRiskSize          Json   @default("{\"min\":50,\"max\":500}")
  followerRiskCollateral    Json   @default("{\"min\":10,\"max\":100}")
  score                     Json   @default("{\"min\":0,\"max\":1}")
  scoreFormular             String @default("RiskAdjustedCopyScore")
  sizingFormular            String @default("ScoreScaledCollateralSizing")

  totalSimulationPlans Int   @default(0)
  completedPlans       Int   @default(0)
  totalLeaderPnl       Float @default(0)
  totalFollowerPnl     Float @default(0)
  totalNetPnlUsd       Float @default(0)
  totalCostUsd         Float @default(0)
  maxDrawdownUsd       Float @default(0)
  tradeCount           Int   @default(0)
  winRate              Float @default(0)
  profitFactor         Float @default(0)

  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  research           SimulationResearch?       @relation(fields: [researchId], references: [id], onDelete: SetNull)
  simulationPlans    SimulationPlan[]
  evaluatorTasks     SimulationEvaluatorTask[]
  executionPlans     SimulationExecutionPlan[]
  sourceSimulation   Simulation?               @relation("SimulationVariants", fields: [sourceSimulationId], references: [id], onDelete: SetNull)
  derivedSimulations Simulation[]              @relation("SimulationVariants")
  derivedResearches  SimulationResearch[]      @relation("SimulationResearchSource")

  @@index([status, createdAt])
  @@index([platform, startAt, endAt])
  @@index([researchId, createdAt])
  @@index([sourceSimulationId])
  @@index([status, automationLeaseExpiresAt])
}

model SimulationExecutionPlan {
  id              String                        @id @default(cuid())
  simulationId    Int
  evaluatorTaskId String?                       @unique
  rangeStartedAt  DateTime
  rangeEndedAt    DateTime
  status          SimulationExecutionPlanStatus @default(Pending)
  leaseToken      String?                       @db.VarChar(64)
  leaseExpiresAt  DateTime?
  attempts        Int                           @default(0)
  lastError       String?
  dispatchedAt    DateTime?
  completedAt     DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  simulation    Simulation               @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  evaluatorTask SimulationEvaluatorTask? @relation(fields: [evaluatorTaskId], references: [id], onDelete: SetNull)

  @@unique([simulationId, rangeStartedAt, rangeEndedAt])
  @@index([status, createdAt])
  @@index([simulationId, status])
  @@index([status, leaseExpiresAt])
}

model Bot {
  id                   Int       @id @default(autoincrement())
  leaderAddress        String    @db.VarChar(255)
  followerAddress      String    @db.VarChar(255)
  strategyId           Int
  status               BotStatus @default(Created)
  leaderContractId     Int
  followerContractId   Int
  followerEndedBlock   Int?
  followerStartedBlock Int?
  leaderEndedBlock     Int?
  leaderStartedBlock   Int?
  endedAt              DateTime?
  startedAt            DateTime?
  planId               Int       @default(0)
  mode                 BotMode   @default(Default)

  follower         Follower  @relation(fields: [followerAddress], references: [address])
  followerContract Contract  @relation("followerBots", fields: [followerContractId], references: [id])
  leaderContract   Contract  @relation("leaderBots", fields: [leaderContractId], references: [id])
  plan             Plan      @relation(fields: [planId], references: [id])
  strategy         Strategy  @relation(fields: [strategyId], references: [id])
  missions         Mission[]
}

model SimulationBot {
  id                    Int       @id @default(autoincrement())
  leaderAddress         String    @db.VarChar(255)
  leaderPlatform        Platform
  stoppedAt             DateTime?
  startedAt             DateTime
  simulationPlanId      Int       @default(0)
  sourceSimulationBotId Int?
  mode                  BotMode   @default(Default)
  ratio                 Float     @default(1)
  score                 Float     @default(0)
  minCollateral         Float     @default(0)
  maxCollateral         Float     @default(1000000000)
  minSize               Float     @default(0)
  maxSize               Float     @default(1000000000)
  minLeverage           Float     @default(0)
  maxLeverage           Float     @default(50)

  leaderExecutionCollateral Json @default("[]")
  leaderExecutionSize       Json @default("[]")
  leaderExecutionLeverage   Json @default("[]")
  followerRiskSize          Json @default("[]")
  followerRiskCollateral    Json @default("[]")

  evaluationTradeCount     Int   @default(0)
  evaluationSlope          Float @default(0)
  evaluationR2             Float @default(0)
  evaluationCopiedPnlUsd   Float @default(0)
  evaluationProfitFactor   Float @default(0)
  evaluationMaxDrawdownUsd Float @default(0)

  openedPositions              Int   @default(0)
  totalPositions               Int   @default(0)
  totalPnl                     Float @default(0)
  maxDuration                  Float @default(0)
  avgDuration                  Float @default(0)
  avgPnl                       Float @default(0)
  avgPositivePnl               Float @default(0)
  avgNegativePnl               Float @default(0)
  avgSize                      Float @default(0)
  avgCollateral                Float @default(0)
  avgPnlPercentageBySize       Float @default(0)
  avgPnlPercentageByCollateral Float @default(0)
  avgLeverage                  Float @default(0)

  simulationPlan        SimulationPlan      @relation(fields: [simulationPlanId], references: [id])
  cache                 SimulationBotCache?
  sourceSimulationBot   SimulationBot?      @relation("SimulationBotVariants", fields: [sourceSimulationBotId], references: [id], onDelete: SetNull)
  derivedSimulationBots SimulationBot[]     @relation("SimulationBotVariants")

  @@unique([simulationPlanId, leaderAddress, leaderPlatform, mode, ratio, minCollateral, maxCollateral, minSize, maxSize, minLeverage, maxLeverage], map: "SimulationBot_three_layer_execution_key")
  @@index([leaderPlatform, leaderAddress])
  @@index([sourceSimulationBotId])
}

model SimulationEvaluatorTask {
  id     String                        @id @default(cuid())
  kind   SimulationEvaluatorTaskKind
  status SimulationEvaluatorTaskStatus @default(Queued)

  simulationId         Int?
  simulationPlanId     Int?
  platform             Platform?
  targetWorkerId       String?
  requiredCacheStartAt DateTime?
  requiredCacheEndAt   DateTime?
  rangeStartedAt       DateTime
  rangeEndedAt         DateTime
  input                Json
  inputChecksum        String
  dedupeKey            String?   @unique
  result               Json?
  resultChecksum       String?

  workerId             String?
  leaseToken           String?
  leaseExpiresAt       DateTime?
  claimedAt            DateTime?
  completedAt          DateTime?
  lastError            String?
  progressPercent      Float     @default(0)
  progressMessage      String?
  progressBytes        BigInt    @default(0)
  progressRecords      BigInt    @default(0)
  progressTotalRecords BigInt    @default(0)

  simulation     Simulation?              @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  simulationPlan SimulationPlan?          @relation(fields: [simulationPlanId], references: [id], onDelete: Cascade)
  executionPlan  SimulationExecutionPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([workerId, status])
  @@index([targetWorkerId, status])
  @@index([platform, status])
  @@index([simulationId, rangeStartedAt, rangeEndedAt])
}

model SimulationBotCache {
  id                           Int       @id @default(autoincrement())
  simulationBotId              Int       @unique
  completed                    Boolean   @default(false)
  rebuilding                   Boolean   @default(false)
  rebuildRequested             Boolean   @default(false)
  eventSnapshotVersion         Int       @default(2)
  lastFetchedAt                DateTime?
  openedPositions              Int       @default(0)
  totalPositions               Int       @default(0)
  totalLeaderPnl               Float     @default(0)
  totalFollowerPnl             Float     @default(0)
  maxDuration                  Float     @default(0)
  avgDuration                  Float     @default(0)
  avgPnl                       Float     @default(0)
  avgPositivePnl               Float     @default(0)
  avgNegativePnl               Float     @default(0)
  avgSize                      Float     @default(0)
  avgCollateral                Float     @default(0)
  avgPnlPercentageBySize       Float     @default(0)
  avgPnlPercentageByCollateral Float     @default(0)
  avgLeverage                  Float     @default(0)
  positionsJson                String    @default("[]")
  followerPositionPnlsJson     String    @default("[]")
  realizedEquityCurveJson      String    @default("[]")
  lastError                    String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  simulationBot SimulationBot                 @relation(fields: [simulationBotId], references: [id], onDelete: Cascade)
  eventLogs     SimulationBotCachedEventLog[]
}

model SimulationBotCachedEventLog {
  id                   Int      @id @default(autoincrement())
  simulationBotCacheId Int
  sourceEventLogKey    String   @db.VarChar(255)
  contractId           Int
  address              String   @db.VarChar(255)
  platform             Platform
  block                Int
  logIndex             Int
  transactionHash      String
  date                 DateTime
  jsonLog              String
  usdPnl               Float
  createdAt            DateTime @default(now())

  simulationBotCache SimulationBotCache @relation(fields: [simulationBotCacheId], references: [id], onDelete: Cascade)

  @@unique([simulationBotCacheId, sourceEventLogKey])
  @@index([simulationBotCacheId, date, block, logIndex, contractId])
}

model SimulationPlanCache {
  id               Int       @id @default(autoincrement())
  simulationPlanId Int       @unique
  completed        Boolean   @default(false)
  rebuilding       Boolean   @default(false)
  completedBots    Int       @default(0)
  incompleteBots   Int       @default(0)
  openedPositions  Int       @default(0)
  totalPositions   Int       @default(0)
  totalLeaderPnl   Float     @default(0)
  totalFollowerPnl Float     @default(0)
  realizedEquityCurveJson String @default("[]")
  lastBuiltAt      DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  simulationPlan SimulationPlan @relation(fields: [simulationPlanId], references: [id], onDelete: Cascade)
}

model Mission {
  id                         Int           @id @default(autoincrement())
  botId                      Int
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  status                     MissionStatus
  achievePositionKey         String?
  targetPositionKey          String
  achievePositionBlockNumber Int?
  achievePositionLogIndex    Int?
  targetPositionBlockNumber  Int
  targetPositionLogIndex     Int
  mode                       MissionMode   @default(Default)
  bot                        Bot           @relation(fields: [botId], references: [id])
  tasks                      Task[]
}

model Task {
  id              Int              @id @default(autoincrement())
  missionId       Int
  actionId        Int
  status          TaskStatus
  logs            String[]
  createdAt       DateTime         @default(now())
  followerActions FollowerAction[]
  action          Action           @relation(fields: [actionId], references: [id])
  mission         Mission          @relation(fields: [missionId], references: [id])

  @@unique([missionId, actionId])
}

model Action {
  id              Int                @id @default(autoincrement())
  contractId      Int?
  origin          ActionOrigin       @default(Chain)
  status          ActionStatus       @default(Observed)
  name            String
  args            String
  blockNumber     Int
  orderInBlock    Int
  blockHash       String?
  txHash          String?
  dedupeKey       String?
  createdAt       DateTime           @default(now())
  positionKey     String
  address         String
  contract        Contract?          @relation(fields: [contractId], references: [id])
  processings     ActionProcessing[]
  followerActions FollowerAction[]
  tasks           Task[]

  @@unique([contractId, blockNumber, orderInBlock])
  @@unique([dedupeKey])
  @@index([contractId, address, blockNumber, orderInBlock])
}

model ActionProcessing {
  actionId    Int
  processor   String
  status      ActionProcessingStatus @default(Pending)
  error       String?
  processedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  action      Action                 @relation(fields: [actionId], references: [id])

  @@id([actionId, processor])
  @@index([processor, status, updatedAt])
}

model FollowerAction {
  id       Int    @id @default(autoincrement())
  actionId Int
  taskId   Int
  action   Action @relation(fields: [actionId], references: [id])
  task     Task   @relation(fields: [taskId], references: [id])

  @@unique([actionId, taskId])
}

model SLTPRequest {
  id          Int      @id @default(autoincrement())
  address     String
  contractId  Int
  positionKey String
  condition   String
  createdAt   DateTime @default(now())
  contract    Contract @relation(fields: [contractId], references: [id])
}

model GnsPricingRecord {
  id    Int      @id @default(autoincrement())
  pair  String
  price Float    @default(0)
  date  DateTime

  @@index([pair, date])
}

enum Platform {
  GNS
  GMX
  AVNT
}

enum Version {
  V9
  V10
  V2
  V1
}

enum ContractStatus {
  Live
  Dead
}

enum ActionOrigin {
  Chain
  Manual
  System
  Clone
  Simulation
}

enum ActionStatus {
  Observed
  Confirmed
  Orphaned
}

enum ActionProcessingStatus {
  Pending
  Processing
  Processed
  Failed
}

enum TradeActionType {
  TradeOpenedMarket
  TradeOpenedLimit
  TradeClosedMarket
  TradeClosedLIQ
  TradeClosedSL
  TradeClosedTP
  TradeLeverageUpdate
  TradePosSizeIncrease
  TradePosSizeDecrease
  TradePosPnlRealized
}

enum LogSeverity {
  Emergency
  Alert
  Critical
  Error
  Warning
  Notice
  Info
  Debug
  Default
}

enum UserPermission {
  Admin
  Trader
  Trial
}

enum BotStatus {
  Created
  Live
  Stop
  Dead
}

enum PlanStatus {
  Created
  Started
  Stopped
  Finished
}

enum MissionStatus {
  Opened
  Closed
  Created
  Opening
  Closing
  Ignored
}

enum MissionMode {
  Default
  Signal
}

enum TaskStatus {
  Created
  Await
  Initiated
  Failed
  Completed
  Stopped
}
