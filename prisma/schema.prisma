// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Metadata {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  Leader
  User
}

enum BotStatus {
  Created
  Live
  Stop
  Dead
}

model User {
  address String   @id @db.VarChar(255)
  role    UserRole

  follower Follower?
  bots     Bot[]
}

model Follower {
  address      String @id @db.VarChar(255)
  publicKey    String @unique
  accountIndex Int    @unique // this is master follower

  user User  @relation(fields: [address], references: [address])
  bots Bot[]
}

model StrategyMetadata {
  key         String @id @db.VarChar(255)
  title       String @db.VarChar(255)
  description String

  strategies Strategy[]
}

model Strategy {
  id                 Int    @id @default(autoincrement())
  strategyKey        String
  ratio              Int    @default(100)
  lifeTime           Int // unit is min
  minCapacity        Int // usdc
  maxCapacity        Int // usdc
  minCollateral      Int // usdc
  maxCollateral      Int // usdc
  collateralBaseline Int // usdc
  maxLeverage        Int    @default(200000)
  minLeverage        Int    @default(1100)
  params             String

  strategyMetadata StrategyMetadata @relation(fields: [strategyKey], references: [key])

  bots Bot[]
}

enum ContractStatus {
  Live
  Dead
}

model Contract {
  id              Int            @id @default(autoincrement())
  chainId         Int
  address         String
  description     String
  lastBlockNumber Int
  status          ContractStatus @default(Live)

  leaderBots   Bot[]      @relation("leaderBots")
  followerBots Bot[]      @relation("followerBots")
  positions    Position[]

  @@unique([chainId, address])
}

model Bot {
  id                       Int       @id @default(autoincrement())
  leaderAddress            String    @db.VarChar(255)
  followerAddress          String    @db.VarChar(255)
  strategyId               Int
  leaderContractId         Int
  leaderCollateralBaseline Int
  leaderStartedBlock       Int?
  leaderEndedBlock         Int?
  followerContractId       Int
  followerStartedBlock     Int?
  followerEndedBlock       Int?
  startedAt                DateTime?
  endedAt                  DateTime?
  status                   BotStatus @default(Created)

  follower         Follower @relation(fields: [followerAddress], references: [address])
  leader           User     @relation(fields: [leaderAddress], references: [address])
  strategy         Strategy @relation(fields: [strategyId], references: [id])
  leaderContract   Contract @relation("leaderBots", fields: [leaderContractId], references: [id])
  followerContract Contract @relation("followerBots", fields: [followerContractId], references: [id])

  missions Mission[]
}

model Position {
  id         Int    @id @default(autoincrement())
  contractId Int
  address    String @db.VarChar(255)
  index      Int

  contract        Contract  @relation(fields: [contractId], references: [id])
  targetMissions  Mission[] @relation("targetMissions")
  achieveMissions Mission[] @relation("achieveMissions")
  actions         Action[]

  @@unique([contractId, address, index])
}

enum MissionStatus {
  Created
  Opening
  Opened
  Closing
  Closed
}

model Mission {
  id                Int           @id @default(autoincrement())
  botId             Int
  targetPositionId  Int
  achievePositionId Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  status            MissionStatus

  targetPosition  Position  @relation("targetMissions", fields: [targetPositionId], references: [id])
  achievePosition Position? @relation("achieveMissions", fields: [achievePositionId], references: [id])
  bot             Bot       @relation(fields: [botId], references: [id])
  tasks           Task[]

  @@unique([botId, targetPositionId])
}

enum TaskStatus {
  Created
  Await
  Initiated
  Failed
  Stopped
  Completed
}

model Task {
  id        Int        @id @default(autoincrement())
  missionId Int
  actionId  Int
  status    TaskStatus
  logs      String[]
  createdAt DateTime   @default(now())

  action          Action           @relation(fields: [actionId], references: [id])
  mission         Mission          @relation(fields: [missionId], references: [id])
  followerActions FollowerAction[]

  @@unique([missionId, actionId])
}

model Action {
  id           Int      @id @default(autoincrement())
  name         String
  positionId   Int
  args         String
  blockNumber  Int
  orderInBlock Int
  createdAt    DateTime @default(now())

  position       Position        @relation(fields: [positionId], references: [id])
  tasks          Task[]
  followerAction FollowerAction?
}

model FollowerAction {
  id       Int @id @default(autoincrement())
  actionId Int @unique
  taskId   Int

  action Action @relation(fields: [actionId], references: [id])
  task   Task   @relation(fields: [taskId], references: [id])

  @@unique([actionId, taskId])
}
