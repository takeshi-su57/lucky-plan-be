generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Metadata {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StrategyMode {
  Default
  Signal
}

model Strategy {
  id              Int          @id @default(autoincrement())
  tpPercentage    Float        @default(0)
  slPercentage    Float        @default(0)
  maxOpenMissions Int          @default(0)
  selectedPairs   String       @default("[]")
  mode            StrategyMode @default(Default)
  maxLeverage     Int          @default(200000)
  minLeverage     Int          @default(1100)
  ratio           Float        @default(1)
  maxCollateral   Int
  minCollateral   Int
  lifeTime        Int

  bots Bot[]
}

model Contract {
  id                         Int             @id @default(autoincrement())
  chainId                    Int
  address                    String
  description                String
  lastBlockNumber            Int
  status                     ContractStatus  @default(Live)
  lastLeaderboardBlockNumber Int             @default(0)
  backendUrl                 String?
  fromBlock                  Int             @default(0)
  platform                   Platform        @default(GNS)
  toBlock                    Int?
  version                    Version         @default(V9)
  followerBots               Bot[]           @relation("followerBots")
  leaderBots                 Bot[]           @relation("leaderBots")
  sltprequests               SLTPRequest[]
  actions                    Action[]
  simulationBots             SimulationBot[] @relation("leaderSimulationBots")

  @@unique([chainId, address, version, platform])
}

model PerpTradingEventLog {
  id         Int      @id @default(autoincrement())
  contractId Int
  jsonLog    String
  usdPnl     Float
  block      Int
  logIndex   Int
  date       DateTime
  address    String
  platform   Platform

  @@unique([address, contractId, block, logIndex])
  @@index([platform, address, date, block, id])
  @@index([platform, date, block, id])
}

model PnlSnapshotV2 {
  platform  Platform
  address   String
  dateStr   String
  accUSDPnl Float

  @@id([address, platform, dateStr])
  @@index([dateStr, platform, accUSDPnl(sort: Desc), address(sort: Asc)])
}

model PnlSnapshotV2InitializedFlag {
  id       Int      @id @default(autoincrement())
  dateStr  String
  isInit   Boolean  @default(false)
  platform Platform

  @@unique([platform, dateStr])
}

model Log {
  id        Int         @id @default(autoincrement())
  severity  LogSeverity
  timestamp DateTime    @default(now())
  summary   String
  details   String?
  checked   Boolean     @default(false)

  @@index([severity, timestamp(sort: Desc)])
}

model User {
  address            String         @unique
  secondAddress      String?        @unique
  mnemonic           String
  permission         UserPermission
  allowAuto          Boolean        @default(false)
  budget             Float          @default(0)
  ratio              Float          @default(1)
  followerContractId Int            @default(0)
}

model Follower {
  address      String @id @db.VarChar(255)
  publicKey    String @unique
  accountIndex Int
  userId       String @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots         Bot[]

  @@unique([userId, accountIndex])
}

model Plan {
  id             Int        @id @default(autoincrement())
  title          String
  description    String
  startedAt      DateTime?
  endedAt        DateTime?
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         PlanStatus
  userId         String     @default("0x104b4e127b9a6c82044c972caff88e75f41ae8cc")
  bots           Bot[]
}

model SimulationPlan {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  startAt      DateTime
  endAt        DateTime
  cursor       DateTime
  simulationId Int?

  openedPositions  Int   @default(0)
  totalPositions   Int   @default(0)
  totalLeaderPnl   Float @default(0)
  totalFollowerPnl Float @default(0)

  simulationBots   SimulationBot[]
  simulation       Simulation?                 @relation(fields: [simulationId], references: [id])
  leaderSelections SimulationLeaderSelection[]
  cache            SimulationPlanCache?

  @@index([simulationId, startAt])
}

model SimulationResearch {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  platform    Platform
  startAt     DateTime
  endAt       DateTime
  direction   BotMode  @default(Reversed)

  trade Json @default("[]")
  r2    Json @default("[]")
  slope Json @default("[]")

  maxLeverage Json @default("[]")

  simulations Simulation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

enum BotMode {
  Default
  Reversed
}

enum SimulationStatus {
  Created
  Running
  Paused
  Completed
  Failed
  Cancelled
}

model Simulation {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  platform Platform

  researchId Int?
  direction  BotMode @default(Reversed)

  startAt         DateTime
  endAt           DateTime
  cursor          DateTime?
  status          SimulationStatus @default(Created)
  progressPhase   String?
  progressMessage String?
  progressPercent Float            @default(0)

  selectedLeaderCount Int   @default(10)
  trade               Json  @default("{\"min\":3,\"max\":1000000}")
  r2                  Json  @default("{\"min\":0.5,\"max\":1}")
  slope               Json  @default("{\"min\":0,\"max\":1000000000}")

  standardCollateralUsd Float @default(100)
  maxLeverage           Float @default(50)

  totalSimulationPlans Int   @default(0)
  completedPlans       Int   @default(0)
  totalLeaderPnl       Float @default(0)
  totalFollowerPnl     Float @default(0)
  totalNetPnlUsd       Float @default(0)
  totalCostUsd         Float @default(0)
  maxDrawdownUsd       Float @default(0)
  tradeCount           Int   @default(0)
  winRate              Float @default(0)
  profitFactor         Float @default(0)

  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  research         SimulationResearch?       @relation(fields: [researchId], references: [id], onDelete: SetNull)
  simulationPlans  SimulationPlan[]
  leaderSelections SimulationLeaderSelection[]

  @@index([status, createdAt])
  @@index([platform, startAt, endAt])
  @@index([researchId, createdAt])
}

model SimulationLeaderSelection {
  id               Int      @id @default(autoincrement())
  simulationId     Int
  simulationPlanId Int?
  leaderAddress    String   @db.VarChar(255)
  date             DateTime

  score                  Float @default(0)
  suggestedRatio         Float @default(0)
  suggestedCollateralUsd Float @default(0)
  rawTotalPnlUsd         Float @default(0)
  rawSlope               Float @default(0)
  rawR2                  Float @default(0)
  rawTradeCount          Int   @default(0)
  reverseNetPnlUsd       Float @default(0)
  reverseDrawdownUsd     Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  simulation     Simulation      @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  simulationPlan SimulationPlan? @relation(fields: [simulationPlanId], references: [id])

  @@unique([simulationPlanId, leaderAddress])
  @@index([simulationId, date])
  @@index([leaderAddress])
}

model Bot {
  id                   Int       @id @default(autoincrement())
  leaderAddress        String    @db.VarChar(255)
  followerAddress      String    @db.VarChar(255)
  strategyId           Int
  status               BotStatus @default(Created)
  leaderContractId     Int
  followerContractId   Int
  followerEndedBlock   Int?
  followerStartedBlock Int?
  leaderEndedBlock     Int?
  leaderStartedBlock   Int?
  endedAt              DateTime?
  startedAt            DateTime?
  planId               Int       @default(0)
  mode                 BotMode   @default(Default)

  follower         Follower  @relation(fields: [followerAddress], references: [address])
  followerContract Contract  @relation("followerBots", fields: [followerContractId], references: [id])
  leaderContract   Contract  @relation("leaderBots", fields: [leaderContractId], references: [id])
  plan             Plan      @relation(fields: [planId], references: [id])
  strategy         Strategy  @relation(fields: [strategyId], references: [id])
  missions         Mission[]
}

model SimulationBot {
  id               Int       @id @default(autoincrement())
  leaderAddress    String    @db.VarChar(255)
  leaderContractId Int
  stoppedAt        DateTime?
  startedAt        DateTime
  simulationPlanId Int       @default(0)
  mode             BotMode   @default(Default)
  ratio            Float     @default(1)
  maxLeverage      Float     @default(50)

  openedPositions              Int   @default(0)
  totalPositions               Int   @default(0)
  totalPnl                     Float @default(0)
  maxDuration                  Float @default(0)
  avgDuration                  Float @default(0)
  avgPnl                       Float @default(0)
  avgPositivePnl               Float @default(0)
  avgNegativePnl               Float @default(0)
  avgSize                      Float @default(0)
  avgCollateral                Float @default(0)
  avgPnlPercentageBySize       Float @default(0)
  avgPnlPercentageByCollateral Float @default(0)
  avgLeverage                  Float @default(0)

  leaderContract Contract       @relation("leaderSimulationBots", fields: [leaderContractId], references: [id])
  simulationPlan SimulationPlan @relation(fields: [simulationPlanId], references: [id])
  cache          SimulationBotCache?
}

model SimulationBotCache {
  id                           Int      @id @default(autoincrement())
  simulationBotId              Int      @unique
  completed                    Boolean  @default(false)
  rebuilding                   Boolean  @default(false)
  rebuildRequested             Boolean  @default(false)
  lastFetchedAt                DateTime?
  openedPositions              Int      @default(0)
  totalPositions               Int      @default(0)
  totalLeaderPnl               Float    @default(0)
  totalFollowerPnl             Float    @default(0)
  maxDuration                  Float    @default(0)
  avgDuration                  Float    @default(0)
  avgPnl                       Float    @default(0)
  avgPositivePnl               Float    @default(0)
  avgNegativePnl               Float    @default(0)
  avgSize                      Float    @default(0)
  avgCollateral                Float    @default(0)
  avgPnlPercentageBySize       Float    @default(0)
  avgPnlPercentageByCollateral Float    @default(0)
  avgLeverage                  Float    @default(0)
  positionsJson                String   @default("[]")
  followerPositionPnlsJson     String   @default("[]")
  lastError                    String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  simulationBot SimulationBot                 @relation(fields: [simulationBotId], references: [id], onDelete: Cascade)
  eventLogs     SimulationBotCachedEventLog[]
}

model SimulationBotCachedEventLog {
  id                   Int      @id @default(autoincrement())
  simulationBotCacheId Int
  sourceEventLogId     Int
  contractId           Int
  address              String   @db.VarChar(255)
  platform             Platform
  block                Int
  logIndex             Int
  date                 DateTime
  jsonLog              String
  usdPnl               Float
  createdAt            DateTime @default(now())

  simulationBotCache SimulationBotCache @relation(fields: [simulationBotCacheId], references: [id], onDelete: Cascade)

  @@unique([simulationBotCacheId, sourceEventLogId])
  @@index([simulationBotCacheId, date, block, id])
}

model SimulationPlanCache {
  id               Int      @id @default(autoincrement())
  simulationPlanId Int      @unique
  completed        Boolean  @default(false)
  rebuilding       Boolean  @default(false)
  completedBots    Int      @default(0)
  incompleteBots   Int      @default(0)
  openedPositions  Int      @default(0)
  totalPositions   Int      @default(0)
  totalLeaderPnl   Float    @default(0)
  totalFollowerPnl Float    @default(0)
  lastBuiltAt      DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  simulationPlan SimulationPlan @relation(fields: [simulationPlanId], references: [id], onDelete: Cascade)
}

model Mission {
  id                         Int           @id @default(autoincrement())
  botId                      Int
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  status                     MissionStatus
  achievePositionKey         String?
  targetPositionKey          String
  achievePositionBlockNumber Int?
  achievePositionLogIndex    Int?
  targetPositionBlockNumber  Int
  targetPositionLogIndex     Int
  mode                       MissionMode   @default(Default)
  bot                        Bot           @relation(fields: [botId], references: [id])
  tasks                      Task[]
}

model Task {
  id              Int              @id @default(autoincrement())
  missionId       Int
  actionId        Int
  status          TaskStatus
  logs            String[]
  createdAt       DateTime         @default(now())
  followerActions FollowerAction[]
  action          Action           @relation(fields: [actionId], references: [id])
  mission         Mission          @relation(fields: [missionId], references: [id])

  @@unique([missionId, actionId])
}

model Action {
  id              Int                @id @default(autoincrement())
  contractId      Int?
  origin          ActionOrigin       @default(Chain)
  status          ActionStatus       @default(Observed)
  name            String
  args            String
  blockNumber     Int
  orderInBlock    Int
  blockHash       String?
  txHash          String?
  dedupeKey       String?
  createdAt       DateTime           @default(now())
  positionKey     String
  address         String
  contract        Contract?          @relation(fields: [contractId], references: [id])
  processings     ActionProcessing[]
  followerActions FollowerAction[]
  tasks           Task[]

  @@unique([contractId, blockNumber, orderInBlock])
  @@unique([dedupeKey])
  @@index([contractId, address, blockNumber, orderInBlock])
}

model ActionProcessing {
  actionId    Int
  processor   String
  status      ActionProcessingStatus @default(Pending)
  error       String?
  processedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  action      Action                 @relation(fields: [actionId], references: [id])

  @@id([actionId, processor])
  @@index([processor, status, updatedAt])
}

model FollowerAction {
  id       Int    @id @default(autoincrement())
  actionId Int
  taskId   Int
  action   Action @relation(fields: [actionId], references: [id])
  task     Task   @relation(fields: [taskId], references: [id])

  @@unique([actionId, taskId])
}

model SLTPRequest {
  id          Int      @id @default(autoincrement())
  address     String
  contractId  Int
  positionKey String
  condition   String
  createdAt   DateTime @default(now())
  contract    Contract @relation(fields: [contractId], references: [id])
}

model GnsPricingRecord {
  id    Int      @id @default(autoincrement())
  pair  String
  price Float    @default(0)
  date  DateTime

  @@index([pair, date])
}

enum Platform {
  GNS
  GMX
  AVNT
}

enum Version {
  V9
  V10
  V2
  V1
}

enum ContractStatus {
  Live
  Dead
}

enum ActionOrigin {
  Chain
  Manual
  System
  Clone
  Simulation
}

enum ActionStatus {
  Observed
  Confirmed
  Orphaned
}

enum ActionProcessingStatus {
  Pending
  Processing
  Processed
  Failed
}

enum TradeActionType {
  TradeOpenedMarket
  TradeOpenedLimit
  TradeClosedMarket
  TradeClosedLIQ
  TradeClosedSL
  TradeClosedTP
  TradeLeverageUpdate
  TradePosSizeIncrease
  TradePosSizeDecrease
  TradePosPnlRealized
}

enum LogSeverity {
  Emergency
  Alert
  Critical
  Error
  Warning
  Notice
  Info
  Debug
  Default
}

enum UserPermission {
  Admin
  Trader
  Trial
}

enum BotStatus {
  Created
  Live
  Stop
  Dead
}

enum PlanStatus {
  Created
  Started
  Stopped
  Finished
}

enum MissionStatus {
  Opened
  Closed
  Created
  Opening
  Closing
  Ignored
}

enum MissionMode {
  Default
  Signal
}

enum TaskStatus {
  Created
  Await
  Initiated
  Failed
  Completed
  Stopped
}
